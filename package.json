{
  "name": "wide-app",
  "version": "0.291126",
  "description": "Autonomous AI workspace and mission control for the Wide ecosystem",
  "private": true,
  "workspaces": [
    "apps/renderer"
  ],
  "scripts": {
    "setup": "npm install && npm run configure",
    "configure": "node scripts/cmake.cjs configure",
    "build": "npm run build:renderer && npm run build:backend && npm run build:host",
    "build:linux": "npm run build:renderer && npm run build:backend",
    "build:renderer": "npm --prefix apps/renderer run build",
    "build:backend": "node apps/backend/build.cjs",
    "build:host": "node scripts/cmake.cjs build",
    "package": "node scripts/package-win.cjs",
    "package:win": "node scripts/package-win.cjs",
    "package:linux": "node scripts/package-linux.cjs",
    "package:deb": "node scripts/build-deb.cjs",
    "package:rpm": "node scripts/build-rpm.cjs",
    "package:arch": "node scripts/build-arch.cjs",
    "package:appimage": "node scripts/build-appimage.cjs",
    "checksums": "node scripts/generate-checksums.cjs",
    "package:all": "npm run package:win && npm run package:linux && npm run package:deb && npm run package:rpm && npm run package:arch && npm run package:appimage && npm run checksums",
    "dev:renderer": "npm --prefix apps/renderer run dev",
    "typecheck": "npm --prefix apps/renderer run typecheck",
    "test": "npm run test:unit && npm run test:smoke",
    "test:unit": "npm --prefix apps/renderer run test",
    "test:smoke": "node sidecar/smoke-backend.cjs",
    "start": "node scripts/start.cjs",
    "start:linux": "electron scripts/host-linux.cjs",
    "dev:linux": "electron scripts/host-linux.cjs --dev",
    "scan": "node scripts/scan.cjs",
    "pitcher": "node scripts/pitcher-run.cjs",
    "catcher": "node scripts/catcher-run.cjs"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.12.5",
    "@grpc/proto-loader": "^0.7.13",
    "@lydell/node-pty": "^1.2.0-beta.14",
    "node-forge": "^1.3.1",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "electron": "^41.7.1"
  },
  "main": "scripts/host-linux.cjs"
}